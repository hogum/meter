{
	"name": "meter",
	"main": "src/index.js",
	"compatibility_date": "2026-10-01",
	"keep_vars": true,
	"workers_dev": false,
	"observability": {
		"enabled": true,
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "meter",
			"database_id": "c720b203-7bc8-441e-bb92-1f84c8a16ad4"
		}
	],
	"triggers": {
		"crons": [
			"*/2 * * * *"
		]
	},
}
