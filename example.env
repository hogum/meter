# 复制为同目录下的 .env，再按需填写。下面的地址、表号和房间号均为示例。

# 登录会话
# 填随机生成的签名密钥。
JWT_SECRET="123456"
# 允许采集、上报和历史导入的表号，用英文逗号分隔。范围包含两端。
METERS=12345678,12345680-12345682

# 可选功能

# 定时采集时，填设备详情接口的完整地址。采集时会自动添加 SerialNo 查询参数。
SOURCE_URL="https://example.com/device-detail"
# 手动上报时填入凭证，上报请求的 tk 参数需与此值一致。
UPLOAD_TOKEN="123456"

# 充值页面地址，跳转时自动加上当前电表的 no 参数。留空时隐藏按钮。
# RECHARGE_URL="https://example.com/recharge"
# 要给 A101 发通知时，取消注释并填入该房间的企业微信群机器人 Webhook 地址。
# WH_A101="https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx"
